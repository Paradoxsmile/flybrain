# data (never commit raw or processed data)
data/raw/*
!data/raw/.gitkeep
data/processed/
# model checkpoints
checkpoints/
*.pt
*.pth
# results: ignore run outputs, keep the small summaries of reported runs
results/**
!results/**/
!results/.gitkeep
!results/*/summary.md
!results/*/SUMMARY.md
!results/**/metrics.csv
!results/vnc_rare/report.json
!results/selection_rules_*.md
results/pytest_*/**
# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
